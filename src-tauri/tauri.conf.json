{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelDeck",
  "version": "1.0.1",
  "identifier": "local.modeldeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelDeck - 多模态 AI 模型工作台",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http: https:; media-src 'self' data: asset: http: https:; font-src 'self' data:; connect-src 'self' ipc: http: https: ws:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$LOCALDATA/**",
          "$TEMP/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ModelDeck",
    "copyright": "Copyright © 2026 ModelDeck",
    "shortDescription": "轻量多模态 AI 模型工作台",
    "longDescription": "轻量多模态 AI 模型工作台 (Local-first multimodal AI workbench)",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
